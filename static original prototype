<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#170b19"><title>MuseCraft AI — Imagine. Create. Share.</title>
<style>
:root{--bg:#120b18;--panel:#21172a;--panel2:#2b1d36;--text:#fff7fc;--muted:#c0aec5;--pink:#ff6b9d;--gold:#ffc879;--cyan:#8de7ee;--line:#ffffff18}*{box-sizing:border-box}body{margin:0;color:var(--text);font:15px/1.55 Inter,system-ui,Arial;background:radial-gradient(ellipse at 15% 0,#51213e 0,transparent 35%),radial-gradient(ellipse at 95% 20%,#26324b 0,transparent 30%),var(--bg)}button,input,textarea,select{font:inherit}button{cursor:pointer}.wrap{width:min(1160px,94%);margin:auto}.nav{display:flex;align-items:center;justify-content:space-between;padding:20px 0;border-bottom:1px solid var(--line);gap:14px}.brand{display:flex;gap:10px;align-items:center;font-size:20px;font-weight:850}.logo{display:grid;place-items:center;width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,var(--pink),var(--gold));color:#28101e;font-size:23px}.tag{color:var(--muted);font-size:12px}.hero{text-align:center;padding:55px 0 35px}.pill{border:1px solid #ff6b9d55;background:#ff6b9d15;color:#ffc6dc;padding:7px 13px;border-radius:99px;font-size:12px}.hero h1{font-size:clamp(36px,7vw,68px);line-height:1.08;letter-spacing:-2px;margin:19px 0}.grad{background:linear-gradient(90deg,var(--pink),var(--gold),var(--cyan));color:transparent;background-clip:text}.hero p{max-width:680px;margin:auto;color:var(--muted);font-size:17px}.chips{display:flex;justify-content:center;gap:9px;flex-wrap:wrap;margin-top:22px}.chip{background:#ffffff0b;border:1px solid var(--line);padding:7px 11px;border-radius:10px;font-size:12px}.layout{display:grid;grid-template-columns:250px 1fr;gap:18px;padding-bottom:45px}.sidebar,.workspace{background:#1a1424e8;border:1px solid var(--line);border-radius:23px;box-shadow:0 20px 65px #0003}.sidebar{padding:15px;height:max-content;position:sticky;top:12px}.sidehead{font-size:11px;letter-spacing:1.5px;color:var(--muted);padding:8px 10px 12px}.navbtn{width:100%;text-align:left;border:1px solid transparent;background:transparent;color:var(--muted);padding:12px;border-radius:13px;margin:3px 0;display:flex;align-items:center;gap:10px}.navbtn.active,.navbtn:hover{background:linear-gradient(110deg,#ff6b9d22,#ffc87912);border-color:#ff6b9d45;color:white}.navbtn span:first-child{font-size:20px}.tip{margin:17px 5px 5px;padding:13px;background:#ffffff08;border-radius:14px;color:var(--muted);font-size:12px}.workspace{padding:clamp(16px,3vw,30px);min-height:500px}.top{display:flex;justify-content:space-between;gap:12px;align-items:start;border-bottom:1px solid var(--line);padding-bottom:17px;margin-bottom:20px}.top h2{margin:0;font-size:25px}.top p{margin:5px 0 0;color:var(--muted)}.status{font-size:10px;color:var(--gold);border:1px solid #ffc87944;padding:6px 9px;border-radius:99px;white-space:nowrap}.panel{display:none}.panel.active{display:block}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}label{font-size:12px;color:#e6d5e9;font-weight:650}input,textarea,select{width:100%;color:var(--text);background:#110d19;border:1px solid #ffffff20;border-radius:12px;padding:12px;outline:none}textarea{min-height:110px;resize:vertical}input:focus,textarea:focus,select:focus{border-color:var(--pink)}select option{background:#21172a}.btnrow{display:flex;gap:9px;flex-wrap:wrap;margin-top:16px}.btn{border:0;border-radius:12px;padding:11px 16px;background:linear-gradient(110deg,var(--pink),var(--gold));color:#2b1020;font-weight:800}.btn.secondary{background:#ffffff0d;color:white;border:1px solid var(--line)}.output{margin-top:18px;padding:16px;border:1px solid var(--line);background:#100c17;border-radius:15px;min-height:95px;white-space:pre-wrap;overflow-wrap:anywhere}.output h3{margin:0 0 8px;font-size:14px;color:var(--gold)}.muted{color:var(--muted);font-size:12px}.choices{display:flex;gap:9px;flex-wrap:wrap;margin-top:15px}.choice{background:#35223f;border:1px solid #ff6b9d66;color:white;padding:10px 14px;border-radius:12px}.choice:hover{background:#53314e}.character{display:grid;grid-template-columns:90px 1fr;gap:15px;align-items:center;padding:15px;background:#ffffff08;border:1px solid var(--line);border-radius:15px}.avatar{width:82px;height:82px;border-radius:24px;display:grid;place-items:center;font-size:38px;background:linear-gradient(135deg,#5b2b58,#233d55)}.chatlog{height:210px;overflow:auto;background:#100c17;border:1px solid var(--line);border-radius:14px;padding:12px;margin-top:12px}.bubble{padding:9px 12px;margin:7px 0;border-radius:12px;max-width:90%;background:#32233d}.bubble.user{margin-left:auto;background:#5b2945}.footer{text-align:center;color:var(--muted);padding:20px;border-top:1px solid var(--line);font-size:12px}.notice{color:#d6c5da;font-size:12px;margin-top:10px}.toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#fff;color:#241323;padding:10px 16px;border-radius:12px;display:none;font-weight:700;z-index:9}
@media(max-width:780px){.layout{grid-template-columns:1fr}.sidebar{position:static;display:flex;flex-wrap:wrap;gap:3px}.sidehead,.tip{display:none}.navbtn{width:auto;flex:1;justify-content:center;padding:10px 8px;font-size:12px}.navbtn span:first-child{font-size:17px}.fields{grid-template-columns:1fr}.top{flex-direction:column}.status{white-space:normal}.hero{padding-top:38px}.brand{font-size:17px}}
</style></head><body><div class="wrap">
<header class="nav"><div class="brand"><div class="logo">✦</div><div>MuseCraft AI<div class="tag">Imagine. Create. Share.</div></div></div><div class="tag">YOUR AI CREATIVE UNIVERSE</div></header>
<section class="hero"><span class="pill">✧ MEDIA · ENTERTAINMENT · DIGITAL EXPERIENCES</span><h1>One idea.<br><span class="grad">Infinite worlds.</span></h1><p>Welcome! Turn your ideas into captivating content, interactive adventures, multilingual videos, and virtual characters—all in one creative studio.</p><div class="chips"><span class="chip">✍️ AI Content Creator</span><span class="chip">🎮 Story Game</span><span class="chip">🌐 Video Dubbing</span><span class="chip">🎭 Virtual Characters</span></div></section>
<main class="layout"><aside class="sidebar"><div class="sidehead">CREATIVE STUDIO</div><button class="navbtn active" data-panel="content"><span>✍️</span>Content Creator</button><button class="navbtn" data-panel="game"><span>🎮</span>Story Game</button><button class="navbtn" data-panel="dubbing"><span>🌐</span>Video Dubbing</button><button class="navbtn" data-panel="character"><span>🎭</span>Character Creator</button><div class="tip">✨ <b>Creative tip</b><br>Choose a style, add details, and make the result your own.</div></aside>
<section class="workspace"><div class="top"><div><h2 id="title">AI Content Creator</h2><p id="desc">Create platform-ready captions, posts, scripts, and creative copy.</p></div><span class="status">✦ INTERACTIVE PROTOTYPE</span></div>
<section class="panel active" id="content"><div class="fields"><div class="field"><label>Content type</label><select id="ctype"><option>Social media caption</option><option>Social media post</option><option>Short video / Reel script</option><option>YouTube video script</option><option>Creative promotional content</option></select></div><div class="field"><label>Platform</label><select id="platform"><option>Instagram</option><option>YouTube</option><option>LinkedIn</option><option>Facebook</option><option>TikTok / Reels</option><option>Any platform</option></select></div><div class="field"><label>Language</label><select id="clang"><option>English</option><option>Tamil</option><option>Hindi</option><option>Malayalam</option><option>Telugu</option><option>Kannada</option><option>Spanish</option><option>French</option></select></div><div class="field"><label>Tone</label><select id="tone"><option>Creative</option><option>Professional</option><option>Funny</option><option>Emotional</option><option>Inspirational</option><option>Trendy</option></select></div><div class="field full"><label>Your topic / idea</label><textarea id="topic" placeholder="Example: A student team builds an innovative AI project for a hackathon..."></textarea></div><div class="field"><label>Length</label><select id="clength"><option>Short</option><option selected>Medium</option><option>Long</option></select></div><div class="field"><label>Include hashtags?</label><select id="hashtags"><option>Yes</option><option>No</option></select></div></div><div class="btnrow"><button class="btn" onclick="makeContent()">✦ Create content</button><button class="btn secondary" onclick="clearOutput('contentOut')">Clear</button></div><div class="output" id="contentOut"><h3>Your creation appears here</h3><span class="muted">Enter a topic and generate a draft. Demo mode uses built-in templates; connect an AI API for live generation.</span></div><div class="btnrow"><button class="btn secondary" onclick="copyOut('contentOut')">Copy</button><button class="btn secondary" onclick="saveOut('contentOut','musecraft-content.txt')">Save .txt</button></div></section>
<section class="panel" id="game"><div class="field"><label>Adventure theme</label><select id="theme"><option>Fantasy mystery</option><option>Space exploration</option><option>Campus adventure</option><option>Time-travel thriller</option><option>Magical kingdom</option></select></div><div class="output" id="gameText"><h3>Your story begins…</h3>Choose a theme and start an adventure where your decisions change the story.</div><div class="choices" id="gameChoices"><button class="btn" onclick="startGame()">▶ Start interactive story</button></div><div class="btnrow"><button class="btn secondary" onclick="resetGame()">Restart story</button></div><p class="notice">Prototype: branching scenes and endings run in the browser. AI-generated dynamic story paths can be connected through a backend.</p></section>
<section class="panel" id="dubbing"><div class="fields"><div class="field full"><label>Upload video or audio</label><input id="mediaFile" type="file" accept="video/*,audio/*"></div><div class="field"><label>Original language</label><select id="sourceLang"><option>Auto detect (demo)</option><option>English</option><option>Tamil</option><option>Hindi</option></select></div><div class="field"><label>Dub into</label><select id="targetLang"><option>Tamil</option><option>English</option><option>Hindi</option><option>Malayalam</option><option>Telugu</option><option>French</option><option>Spanish</option></select></div><div class="field full"><label>Paste dialogue / transcript (demo input)</label><textarea id="dialogue" placeholder="Paste the spoken dialogue here..."></textarea></div></div><div class="btnrow"><button class="btn" onclick="makeDub()">🌐 Create dubbing demo</button><button class="btn secondary" onclick="speakDub()">🔊 Play voice preview</button></div><div class="output" id="dubOut"><h3>Multilingual video studio</h3>Upload a clip and add its transcript to preview the dubbing workflow.</div><div class="btnrow"><button class="btn secondary" onclick="copyOut('dubOut')">Copy subtitles</button><button class="btn secondary" onclick="saveOut('dubOut','musecraft-subtitles.txt')">Save subtitles</button></div><p class="notice">Prototype note: this page previews the workflow and browser voice. Actual video speech recognition, translation, voice cloning/dubbing, and rendered subtitle export require connected AI/media services.</p></section>
<section class="panel" id="character"><div class="fields"><div class="field"><label>Character name</label><input id="charName" placeholder="e.g. Mira"></div><div class="field"><label>Character type</label><select id="charType"><option>Fantasy guide</option><option>Friendly assistant</option><option>Detective</option><option>Space explorer</option><option>Anime-inspired hero</option><option>Wise mentor</option></select></div><div class="field"><label>Personality</label><select id="personality"><option>Kind and curious</option><option>Funny and energetic</option><option>Mysterious and calm</option><option>Brave and confident</option><option>Wise and thoughtful</option></select></div><div class="field"><label>Voice preview</label><select id="voiceStyle"><option>Default browser voice</option><option>Bright</option><option>Calm</option></select></div><div class="field full"><label>Backstory / special ability</label><textarea id="backstory" placeholder="Describe their world, goals, powers, or secrets..."></textarea></div></div><div class="btnrow"><button class="btn" onclick="createCharacter()">✦ Create character</button><button class="btn secondary" onclick="clearChat()">Reset chat</button></div><div class="character" id="charCard"><div class="avatar">🎭</div><div><h3>Your character</h3><p class="muted">Create a character to begin a conversation.</p></div></div><div class="chatlog" id="chatlog"><div class="muted">Your character's conversation will appear here.</div></div><div class="btnrow"><input id="chatInput" placeholder="Talk to your character…" style="flex:1;min-width:160px"><button class="btn" onclick="chatSend()">Send</button><button class="btn secondary" onclick="chatSpeak()">🔊</button></div><p class="notice">Prototype character replies are scripted. Connect a conversational AI and voice service for open-ended dialogue and custom voices.</p></section>
</section></main><footer class="footer">Made for creators, storytellers & dreamers · MuseCraft AI · Domain 8</footer></div><div class="toast" id="toast"></div>
<script>
const names={content:['AI Content Creator','Create captions, social posts, video scripts, and creative copy for different platforms.'],game:['Interactive AI Story Game','Make choices, explore branching story paths, and discover different endings.'],dubbing:['AI Multilingual Video Dubbing','Prepare translated dialogue, subtitle text, and a voice narration preview.'],character:['AI Virtual Character Creator','Design a character personality and chat with your virtual creation.']};let active='content',latestCharacter=null,gameStep=0,gameTheme='';document.querySelectorAll('.navbtn').forEach(b=>b.addEventListener('click',()=>{active=b.dataset.panel;document.querySelectorAll('.navbtn').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.panel').forEach(x=>x.classList.toggle('active',x.id===active));document.getElementById('title').textContent=names[active][0];document.getElementById('desc').textContent=names[active][1]}));
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function toast(t){let x=document.getElementById('toast');x.textContent=t;x.style.display='block';setTimeout(()=>x.style.display='none',1800)}function clearOutput(id){document.getElementById(id).innerHTML='<h3>Ready for your next creation</h3>';}
function makeContent(){let topic=document.getElementById('topic').value.trim();if(!topic){toast('Please enter a topic first');return}let type=document.getElementById('ctype').value,platform=document.getElementById('platform').value,lang=document.getElementById('clang').value,tone=document.getElementById('tone').value,len=document.getElementById('clength').value;let starters={English:'Imagine a world where',Tamil:'ஒரு புதிய சிந்தனையை கற்பனை செய்யுங்கள்:',Hindi:'एक नए विचार की कल्पना करें:',Malayalam:'ഒരു പുതിയ ആശയം സങ്കൽപ്പിക്കൂ:',Telugu:'ఒక కొత్త ఆలోచనను ఊహించండి:',Kannada:'ಒಂದು ಹೊಸ ಆಲೋಚನೆಯನ್ನು ಕಲ್ಪಿಸಿಕೊಳ್ಳಿ:',Spanish:'Imagina un mundo donde',French:'Imagine un monde où'};let lead=starters[lang]||'Imagine';let body=type.includes('script')?`[Opening scene]
Narrator: ${lead} ${topic}.

[Main scene]
Show the idea in action. Build curiosity with a clear moment of surprise.

[Closing]
End with a memorable message and a call to action: “What would you create?”`:`${lead} ${topic}.

${tone==='Funny'?'A little creativity, a lot of fun, and a moment worth sharing!':tone==='Professional'?'Discover a thoughtful approach, meaningful value, and a practical next step.':tone==='Emotional'?'Small moments can inspire extraordinary feelings and lasting memories.':tone==='Inspirational'?'Every big creation begins with one brave idea. Keep imagining and take the first step.':'Turn this idea into something fresh, memorable, and made to connect with your audience.'}`;if(len==='Long')body+='\n\nExplore the idea from a new perspective, add a relatable example, and invite the audience to participate. Keep the message authentic and focused.';if(len==='Short')body=body.split('\n\n')[0];if(document.getElementById('hashtags').value==='Yes')body+='\n\n#CreativeIdeas #MuseCraftAI #'+topic.replace(/[^a-z0-9]/gi,'').slice(0,18);document.getElementById('contentOut').innerHTML=`<h3>${esc(type)} · ${esc(platform)} · ${esc(lang)}</h3>${esc(body)}\n\n<span class="muted">Demo draft • ${esc(tone)} tone</span>`;}
function startGame(){gameStep=0;gameTheme=document.getElementById('theme').value;renderGame(`Your ${gameTheme.toLowerCase()} begins. You discover a glowing doorway with two symbols. What do you do?`,[['Open the doorway',1],['Study the symbols',2]])}function renderGame(text,opts){document.getElementById('gameText').innerHTML='<h3>Chapter '+(gameStep+1)+'</h3>'+esc(text);let c=document.getElementById('gameChoices');c.innerHTML='';opts.forEach(([label,next])=>{let b=document.createElement('button');b.className='choice';b.textContent=label;b.onclick=()=>chooseGame(next);c.appendChild(b)})}function chooseGame(n){gameStep++;let scenes={1:['Inside, a friendly guardian offers you a map.',['Accept the map',3],['Ask the guardian a question',4]],2:['The symbols reveal a hidden clue pointing toward a secret garden.',['Follow the clue',3],['Keep searching',5]],3:['You solve the mystery and unlock a new world. Your courage creates a hopeful ending!',[['Play again',0]]],4:['The guardian shares the truth: your choices shape this world. You become its new storyteller.',['Restart adventure',0]],5:['A secret passage opens behind you. The adventure ends with a surprising discovery!',['Restart adventure',0]]};let s=scenes[n]||scenes[3];if(n===3||n===5){renderGame(s[0],[[s[1][0][0],0]])}else renderGame(s[0],s.slice(1));if(n===0)startGame()}
function resetGame(){document.getElementById('gameText').innerHTML='<h3>Your story begins…</h3>';document.getElementById('gameChoices').innerHTML='<button class="btn" onclick="startGame()">▶ Start interactive story</button>';gameStep=0}
function makeDub(){let file=document.getElementById('mediaFile').files[0],txt=document.getElementById('dialogue').value.trim(),lang=document.getElementById('targetLang').value;if(!file&&!txt){toast('Upload media or paste dialogue');return}let sub=txt||'Transcript preview unavailable for this file in demo mode. Add the spoken dialogue to create subtitle text.';document.getElementById('dubOut').innerHTML=`<h3>Dub workflow · ${esc(lang)}</h3><b>Media:</b> ${esc(file?file.name:'Dialogue text')}\n\n<b>Translated subtitle / narration draft:</b>\n${esc(sub)}\n\n<span class="muted">Demo preview—translation is not automatically performed here.</span>`;window.dubText=txt||sub}function speakDub(){let t=window.dubText||document.getElementById('dialogue').value;if(!t){toast('Create a dubbing preview first');return}if(!('speechSynthesis'in window)){toast('Voice preview is not supported in this browser');return}let u=new SpeechSynthesisUtterance(t);u.lang={'Tamil':'ta-IN','English':'en-IN','Hindi':'hi-IN','Malayalam':'ml-IN','Telugu':'te-IN','French':'fr-FR','Spanish':'es-ES'}[document.getElementById('targetLang').value]||'en';speechSynthesis.speak(u)}
function createCharacter(){let name=document.getElementById('charName').value.trim()||'Mira',type=document.getElementById('charType').value,person=document.getElementById('personality').value,back=document.getElementById('backstory').value;latestCharacter={name,type,person,back};document.getElementById('charCard').innerHTML=`<div class="avatar">${type.includes('Space')?'🚀':type.includes('Detective')?'🕵️':type.includes('Fantasy')?'🧙':'🎭'}</div><div><h3>${esc(name)}</h3><p>${esc(type)} · ${esc(person)}</p><p class="muted">${esc(back||'A new character with a story waiting to unfold.')}</p></div>`;document.getElementById('chatlog').innerHTML=`<div class="bubble">${esc(name)}: Hello! I'm ${esc(name)}. What adventure shall we begin?</div>`}function chatSend(){let input=document.getElementById('chatInput'),msg=input.value.trim();if(!msg)return;if(!latestCharacter)createCharacter();let log=document.getElementById('chatlog');log.innerHTML+=`<div class="bubble user">You: ${esc(msg)}</div>`;let c=latestCharacter;let reply=c.person.includes('Funny')?'That sounds hilarious! Let’s turn it into an unforgettable adventure.':c.person.includes('Mysterious')?'Interesting… every answer hides another secret. Tell me what you noticed.':c.person.includes('Brave')?'We can do this! I’ll stand beside you—what’s our first move?':c.person.includes('Wise')?'Every journey begins with a question. What do you hope to discover?':`That’s interesting! As your ${c.type.toLowerCase()}, I would love to explore that with you. What happens next?`;log.innerHTML+=`<div class="bubble">${esc(c.name)}: ${esc(reply)}</div>`;log.scrollTop=log.scrollHeight;input.value='';window.characterReply=reply}function clearChat(){document.getElementById('chatlog').innerHTML='<div class="muted">Conversation reset.</div>'}function chatSpeak(){if(!window.characterReply){toast('Send a message to hear a reply');return}let u=new SpeechSynthesisUtterance(window.characterReply);speechSynthesis.speak(u)}function copyOut(id){let el=document.getElementById(id);let text=el.innerText;navigator.clipboard?.writeText(text).then(()=>toast('Copied')).catch(()=>toast('Select and copy the text'))}function saveOut(id,name){let text=document.getElementById(id).innerText;let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type:'text/plain'}));a.download=name;a.click();URL.revokeObjectURL(a.href)}document.getElementById('chatInput').addEventListener('keydown',e=>{if(e.key==='Enter')chatSend()});
</script></body></html>
